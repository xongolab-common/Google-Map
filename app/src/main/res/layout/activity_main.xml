<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

     <com.example.googlemap.CustomFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:nestedScrollingEnabled="true"
            android:visibility="visible" />

    </com.example.googlemap.CustomFrameLayout>

    <RelativeLayout
        android:id="@+id/rlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="@dimen/_15sdp"
        android:layout_alignParentTop="true"

        android:background="@drawable/dr_edittext_border">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgOrange"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_alignTop="@+id/tvPickUpLocation"
                android:layout_alignBottom="@id/tvPickUpLocation"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_orange_circle" />

            <View
                android:id="@+id/viewww"
                android:layout_width="@dimen/_2sdp"
                android:layout_height="match_parent"
                android:layout_above="@id/imgRact"
                android:layout_below="@id/imgOrange"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="@color/gray" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPickUpLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@id/imgOrange"
                android:background="@null"
                android:hint="Enter Pickup Location"
                android:singleLine="true"
                android:textColorHint="@color/primary_black" />

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_below="@id/tvPickUpLocation"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_toEndOf="@id/imgOrange"
                android:background="@color/gray" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDropOffLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/view"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_toEndOf="@id/imgRact"
                android:background="@null"
                android:hint="Enter Dropff Location"
                android:singleLine="true"
                android:textColorHint="@color/primary_black" />

            <View
                android:id="@+id/viewDropOff"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_below="@id/tvDropOffLocation"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_toEndOf="@id/imgRact"
                android:background="@color/gray" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgRact"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_alignTop="@id/tvDropOffLocation"
                android:layout_alignBottom="@id/tvDropOffLocation"
                android:src="@drawable/ic_rectangle_black" />

        </RelativeLayout>

    </RelativeLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:paddingBottom="10dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icCurrentLocation"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_location"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icDirection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_direction"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>


</RelativeLayout>